{
  // Type checking of everything, tests included (npm run typecheck). Node runs the .ts files directly by
  // stripping the types, so only erasable TypeScript syntax is allowed; tsconfig.build.json emits dist/.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
